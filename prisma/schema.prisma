generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  member
}

enum TaskStatus {
  todo
  doing
  done
}

enum TaskPriority {
  low
  med
  high
}

enum ChannelKind {
  group
  subject
}

enum TimetableScope {
  group
  personal
}

enum ResourceKind {
  paper
  notes
  book
  video
  link
  other
}

enum ExamKind {
  exam
  assignment
  quiz
  deadline
}

enum NotificationKind {
  task_assigned
  task_comment
  task_mention
  task_status
  task_due
  project_new
  chat_mention
  exam_due
}

model User {
  id           String   @id @default(cuid())
  handle       String   @unique
  name         String
  role         Role     @default(member)
  color        String   @default("#2563eb")
  image        String?
  passwordHash String
  timezone     String   @default("UTC")
  isActive     Boolean  @default(true)
  // Bumped on password change/reset/deactivate to revoke existing sessions.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  // Weekly study target in minutes (0 = no goal set).
  weeklyGoalMinutes   Int       @default(0)
  // Optional per-user GPA scale. Null means "use the built-in percentage bands".
  gpaScale            Json?
  // Optional per-day rest allowance so one missed day doesn't kill a streak.
  streakFreezesFree   Int       @default(1)
  // Notification preferences.
  notifyTasks         Boolean   @default(true)
  notifyExams         Boolean   @default(true)
  // In-app notification event preferences.
  notifyTaskAssigned  Boolean   @default(true)
  notifyTaskComments  Boolean   @default(true)
  notifyTaskStatus    Boolean   @default(true)
  notifyTaskDue       Boolean   @default(true)
  notifyNewProjects   Boolean   @default(true)
  notifyChatMentions  Boolean   @default(true)
  notifyExamReminders Boolean   @default(true)
  // Browser push is opt-in and requires an active push subscription.
  notifyPush          Boolean   @default(false)
  // Presence: the last time this user opened the app.
  lastSeenAt          DateTime?
  // Last time the member opened Chat, used for the unread badge. Null means
  // they have never read chat on this account.
  chatReadAt          DateTime?

  taskAssignments   TaskAssignee[]
  tasksCreated      Task[]             @relation("TaskCreator")
  comments          TaskComment[]
  habits            Habit[]
  sessions          StudySession[]
  messages          Message[]
  auditLogs         AuditLog[]
  uploads           Upload[]
  notes             Note[]
  resources         Resource[]
  exams             Exam[]
  flashcards        Flashcard[]
  reviews           FlashcardReview[]
  questions         Question[]
  answers           Answer[]
  courses           Course[]
  timetable         TimetableEntry[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  resourceFavorites ResourceFavorite[]
  resourceUseful    ResourceUseful[]
  resourceReads     ResourceRead[]

  @@index([role])
}

model Upload {
  id        String    @id @default(cuid())
  url       String    @unique
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mime      String?
  size      Int?
  // Set once the file is attached to a saved form row (session, note, ...).
  // Unattached uploads older than a day are swept by the cleanup job.
  claimedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId])
  @@index([claimedAt, createdAt])
}

model Note {
  id         String   @id @default(cuid())
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  body       String
  subject    String
  // Optional link to the shared Subject. The text field is kept until cleanup.
  subjectId  String?
  subjectRef Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  // Everyone in the group can read and edit notes; only the author (or an
  // admin) can delete one.
  image      String?
  fileUrl    String?
  fileName   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([subject])
  @@index([subjectId])
  @@index([authorId])
  @@index([createdAt])
}

model Resource {
  id         String       @id @default(cuid())
  title      String
  kind       ResourceKind @default(other)
  subject    String
  // Optional link to the shared Subject. The text field is kept until cleanup.
  subjectId  String?
  subjectRef Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  url        String?
  note       String?
  // Metadata for uploaded files.
  fileName   String?
  fileSize   Int?
  mime       String?
  // Past-paper details.
  year       Int?
  semester   String?
  examType   String?
  addedById  String
  addedBy    User         @relation(fields: [addedById], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  favorites ResourceFavorite[]
  useful    ResourceUseful[]
  reads     ResourceRead[]

  @@index([subject])
  @@index([subjectId])
  @@index([kind])
  @@index([year])
}

model ResourceFavorite {
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([resourceId, userId])
  @@index([userId])
}

model ResourceUseful {
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([resourceId, userId])
  @@index([userId])
}

model ResourceRead {
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([resourceId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String?
  href      String?
  // Optional per-user/day key so scheduled reminders are not duplicated.
  dedupeKey String?          @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Exam {
  id          String   @id @default(cuid())
  title       String
  kind        ExamKind @default(exam)
  subject     String
  // Optional link to the shared Subject; the text field is kept until cleanup.
  subjectId   String?
  subjectRef  Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  // Optional project this deadline belongs to.
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // The calendar date of the exam/assignment, as YYYY-MM-DD.
  date        String
  notes       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([subject])
  @@index([subjectId])
  @@index([projectId])
}

model Flashcard {
  id          String   @id @default(cuid())
  deck        String
  // Optional link to the shared Subject.
  subjectId   String?
  subjectRef  Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  front       String
  back        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  reviews FlashcardReview[]

  @@index([deck])
  @@index([subjectId])
}

model FlashcardReview {
  id         String    @id @default(cuid())
  cardId     String
  card       Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Spaced-repetition bookkeeping.
  box        Int       @default(1)
  dueAt      DateTime  @default(now())
  lastResult String?
  updatedAt  DateTime  @updatedAt

  @@unique([cardId, userId])
  @@index([userId, dueAt])
}

model Question {
  id         String   @id @default(cuid())
  subject    String
  // Optional link to the shared Subject. The text field is kept until cleanup.
  subjectId  String?
  subjectRef Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title      String
  body       String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  answers Answer[]

  @@index([subject])
  @@index([subjectId])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  body       String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  accepted   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([questionId])
}

model Course {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name    String
  credits Int    @default(3)

  items GradeItem[]

  @@index([ownerId])
}

model GradeItem {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  // Weight as a percentage of the course grade.
  weight    Int      @default(0)
  // Percentage scored (0-100), or null when ungraded.
  score     Int?
  createdAt DateTime @default(now())

  @@index([courseId])
}

model TimetableEntry {
  id         String         @id @default(cuid())
  ownerId    String
  owner      User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Group entries are shared with everyone; personal entries are only shown to
  // their owner (and in that member's calendar feed).
  scope      TimetableScope @default(group)
  // 0 = Sunday ... 6 = Saturday (JS getDay()).
  weekday    Int
  startMin   Int
  endMin     Int
  title      String
  location   String?
  color      String         @default("#2563eb")
  // Optional link to a shared Subject (course).
  subjectId  String?
  subjectRef Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([ownerId, weekday])
  @@index([scope, weekday])
  @@index([subjectId])
}

model Subject {
  id         String    @id @default(cuid())
  name       String
  color      String    @default("#2563eb")
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  projects         Project[]
  tasks            Task[]
  exams            Exam[]
  channels         Channel[]
  notes            Note[]
  resources        Resource[]
  flashcards       Flashcard[]
  questions        Question[]
  studySessions    StudySession[]
  timetableEntries TimetableEntry[]
}

model Project {
  id         String    @id @default(cuid())
  subjectId  String
  subject    Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title      String
  targetDate DateTime?
  createdAt  DateTime  @default(now())

  tasks Task[]
  exams Exam[]

  @@index([subjectId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(med)
  dueDate     DateTime?
  completedAt DateTime?
  // Null for tasks created before creator tracking was added.
  createdById String?
  createdBy   User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  // A task can sit directly under a subject, or under one of its projects.
  subjectId   String?
  subject     Subject?     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  assignees     TaskAssignee[]
  comments      TaskComment[]
  studySessions StudySession[]

  @@index([subjectId])
  @@index([projectId])
  @@index([createdById])
  @@index([status, completedAt])
}

model TaskAssignee {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Habit {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  checkins HabitCheckIn[]

  @@index([ownerId])
}

model HabitCheckIn {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String
  note      String?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId])
  @@index([date])
}

model StudySession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Optional link to the task this focus block was working on. Deleting the
  // task keeps the study history and just detaches it.
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  subject    String
  // Optional link to the shared Subject. The text field is kept until cleanup.
  subjectId  String?
  subjectRef Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  minutes    Int
  notes      String?
  date       String
  image      String?
  fileUrl    String?
  fileName   String?
  shared     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
  @@index([taskId])
  @@index([subjectId])
}

model Channel {
  id        String      @id @default(cuid())
  name      String
  kind      ChannelKind @default(group)
  subjectId String?
  subject   Subject?    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  messages Message[]

  @@index([subjectId])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([channelId])
  @@index([channelId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  targetId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}
