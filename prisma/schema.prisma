generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  member
}

enum TaskStatus {
  todo
  doing
  done
}

enum TaskPriority {
  low
  med
  high
}

enum ChannelKind {
  group
  project
}

model User {
  id           String   @id @default(cuid())
  handle       String   @unique
  name         String
  role         Role     @default(member)
  color        String   @default("#2563eb")
  image        String?
  passwordHash String
  timezone     String   @default("UTC")
  isActive     Boolean  @default(true)
  // Bumped on password change/reset/deactivate to revoke existing sessions.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  tasks    Task[]
  comments TaskComment[]
  habits   Habit[]
  sessions StudySession[]
  messages Message[]
  auditLogs AuditLog[]

  @@index([role])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  tasks    Task[]
  goals    Goal[]
  channels Channel[]
}

model Goal {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  targetDate DateTime?
  createdAt  DateTime @default(now())

  tasks Task[]

  @@index([projectId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(med)
  dueDate     DateTime?
  completedAt DateTime?
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goalId      String?
  goal        Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  comments TaskComment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status, completedAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Habit {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  checkins HabitCheckIn[]

  @@index([ownerId])
}

model HabitCheckIn {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String
  note      String?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId])
  @@index([date])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  minutes   Int
  notes     String?
  date      String
  image     String?
  fileUrl   String?
  fileName  String?
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
}

model Channel {
  id        String      @id @default(cuid())
  name      String
  kind      ChannelKind @default(group)
  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  messages Message[]

  @@index([projectId])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([channelId])
  @@index([channelId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  targetId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

