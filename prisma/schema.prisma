generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  member
}

enum TaskStatus {
  todo
  doing
  done
}

enum TaskPriority {
  low
  med
  high
}

enum ChannelKind {
  group
  project
}

enum ResourceKind {
  paper
  notes
  book
  video
  link
  other
}

enum ExamKind {
  exam
  assignment
  quiz
  deadline
}

model User {
  id           String   @id @default(cuid())
  handle       String   @unique
  name         String
  role         Role     @default(member)
  color        String   @default("#2563eb")
  image        String?
  passwordHash String
  timezone     String   @default("UTC")
  isActive     Boolean  @default(true)
  // Bumped on password change/reset/deactivate to revoke existing sessions.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  // Weekly study target in minutes (0 = no goal set).
  weeklyGoalMinutes Int       @default(0)
  // Optional per-day rest allowance so one missed day doesn't kill a streak.
  streakFreezesFree Int       @default(1)
  // Notification preferences.
  notifyTasks       Boolean   @default(true)
  notifyExams       Boolean   @default(true)
  // Presence: the last time this user opened the app.
  lastSeenAt        DateTime?

  tasks      Task[]
  comments   TaskComment[]
  habits     Habit[]
  sessions   StudySession[]
  messages   Message[]
  auditLogs  AuditLog[]
  uploads    Upload[]
  notes      Note[]
  resources  Resource[]
  exams      Exam[]
  flashcards Flashcard[]
  reviews    FlashcardReview[]
  questions  Question[]
  answers    Answer[]
  courses    Course[]
  timetable  TimetableEntry[]

  @@index([role])
}

model Upload {
  id        String    @id @default(cuid())
  url       String    @unique
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mime      String?
  size      Int?
  // Set once the file is attached to a saved form row (session, note, ...).
  // Unattached uploads older than a day are swept by the cleanup job.
  claimedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId])
  @@index([claimedAt, createdAt])
}

model Note {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  subject   String
  // Everyone in the group can read and edit notes; only the author (or an
  // admin) can delete one.
  image     String?
  fileUrl   String?
  fileName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subject])
  @@index([authorId])
  @@index([createdAt])
}

model Resource {
  id        String       @id @default(cuid())
  title     String
  kind      ResourceKind @default(other)
  subject   String
  url       String?
  note      String?
  addedById String
  addedBy   User         @relation(fields: [addedById], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([subject])
  @@index([kind])
}

model Exam {
  id          String   @id @default(cuid())
  title       String
  kind        ExamKind @default(exam)
  subject     String
  // The calendar date of the exam/assignment, as YYYY-MM-DD.
  date        String
  notes       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([subject])
}

model Flashcard {
  id          String   @id @default(cuid())
  deck        String
  front       String
  back        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  reviews FlashcardReview[]

  @@index([deck])
}

model FlashcardReview {
  id         String    @id @default(cuid())
  cardId     String
  card       Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Spaced-repetition bookkeeping.
  box        Int       @default(1)
  dueAt      DateTime  @default(now())
  lastResult String?
  updatedAt  DateTime  @updatedAt

  @@unique([cardId, userId])
  @@index([userId, dueAt])
}

model Question {
  id        String   @id @default(cuid())
  subject   String
  title     String
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  answers Answer[]

  @@index([subject])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  body       String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  accepted   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([questionId])
}

model Course {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name    String
  credits Int    @default(3)

  items GradeItem[]

  @@index([ownerId])
}

model GradeItem {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  // Weight as a percentage of the course grade.
  weight    Int      @default(0)
  // Percentage scored (0-100), or null when ungraded.
  score     Int?
  createdAt DateTime @default(now())

  @@index([courseId])
}

model TimetableEntry {
  id       String  @id @default(cuid())
  ownerId  String
  owner    User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // 0 = Sunday ... 6 = Saturday (JS getDay()).
  weekday  Int
  startMin Int
  endMin   Int
  title    String
  location String?
  color    String  @default("#2563eb")

  @@index([ownerId, weekday])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  tasks    Task[]
  goals    Goal[]
  channels Channel[]
}

model Goal {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  targetDate DateTime?
  createdAt  DateTime  @default(now())

  tasks Task[]

  @@index([projectId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(med)
  dueDate     DateTime?
  completedAt DateTime?
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goalId      String?
  goal        Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  comments      TaskComment[]
  studySessions StudySession[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status, completedAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Habit {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  checkins HabitCheckIn[]

  @@index([ownerId])
}

model HabitCheckIn {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String
  note      String?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId])
  @@index([date])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Optional link to the task this focus block was working on. Deleting the
  // task keeps the study history and just detaches it.
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  subject   String
  minutes   Int
  notes     String?
  date      String
  image     String?
  fileUrl   String?
  fileName  String?
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
  @@index([taskId])
}

model Channel {
  id        String      @id @default(cuid())
  name      String
  kind      ChannelKind @default(group)
  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  messages Message[]

  @@index([projectId])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([channelId])
  @@index([channelId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  targetId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}
