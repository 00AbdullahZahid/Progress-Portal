# Postgres connection string (works for both local dev and Vercel).
# On Vercel's Postgres integration this is the pooled URL (POSTGRES_PRISMA_URL).
DATABASE_URL="postgresql://user:password@host-pooler:6543/dbname?sslmode=require"

# Direct (non-pooled) connection used by Prisma Migrate. On Vercel this is
# POSTGRES_URL_NON_POOLING. Running migrations through a pooler often fails.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign session cookies. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-hex"

# Public URL of the app.
APP_URL="http://localhost:3000"

# Comma-separated handles that become super admins when the seed runs.
ADMIN_HANDLES="admin"

# Set to "1" to let the seed create starter member accounts (see prisma/seed.ts).
# Leave "0" (or unset) in production. New members should be added from the admin UI.
SEED_MEMBERS="0"

# Optional: password used for the seeded admin. If unset, the seed generates a
# random one and prints it once. Never commit a real password.
# SEED_ADMIN_PASSWORD=""

# Vercel Blob read/write token, used for study attachments and profile pictures.
# Create a Blob store in the Vercel dashboard (Storage > Blob) and copy the
# token. Leave unset to disable uploads (the rest of the app keeps working).
# BLOB_READ_WRITE_TOKEN=""

# Secret that Vercel Cron sends as a bearer token to /api/cleanup and /api/notify.
# Leave unset to allow only non-production manual runs.
# CRON_SECRET=""

# Optional webhook for the daily notification digest. Supports Discord, Telegram
# (also set NOTIFY_TELEGRAM_CHAT_ID) and any endpoint accepting { "text": ... }.
# NOTIFY_WEBHOOK_URL=""
# NOTIFY_TELEGRAM_CHAT_ID=""
